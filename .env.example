# CareRoute environment configuration.
# Copy this file to `.env` and fill in as needed:  cp .env.example .env
#
# IMPORTANT: keep comments on their OWN lines, starting with `#`.
# Do NOT put an inline comment after a value that might be empty — python-dotenv
# reads `KEY=            # note` as the literal value "# note", not as empty.
# That is exactly what silently turned API-key auth on and caused 401s.

# --- LLM ---
# Your OpenAI key. Required for the agent to run.
OPENAI_API_KEY=

# --- Provider backend ---
# One of: unset (dummy JSON), osm (free OpenStreetMap), google (Google Places).
USE_REAL_PROVIDERS=osm

# Only needed when USE_REAL_PROVIDERS=google.
GOOGLE_MAPS_API_KEY=

# --- Rate limiting (per client IP) ---
# Requests allowed per minute, and the burst the bucket can hold.
CAREROUTE_RATE_PER_MIN=20
CAREROUTE_BURST=5

# --- API-key gate (OPTIONAL) ---
# Leave EMPTY for an open endpoint (the default for local dev and the demo).
# To lock it down for a private beta, set a comma-separated list of keys, e.g.
# CAREROUTE_API_KEYS=beta-key-abc,beta-key-def
# and set the matching API_KEY constant in index.html.
CAREROUTE_API_KEYS=

# --- Daily circuit breaker (OPTIONAL) ---
# 0 disables it. Set a number (e.g. 1000) as a global backstop on /care calls.
CAREROUTE_DAILY_CALL_CAP=0

# --- CORS ---
# "*" for local dev. In production set your real origin, e.g.
# CAREROUTE_ALLOWED_ORIGINS=https://careroute.app
CAREROUTE_ALLOWED_ORIGINS=*

# --- Proxy trust ---
# 1 = read the client IP from X-Forwarded-For (correct behind Azure Container
# Apps ingress). Set to 0 only if the container is exposed directly.
CAREROUTE_TRUST_XFF=1
