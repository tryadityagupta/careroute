
OPENAI_API_KEY=
USE_REAL_PROVIDERS=osm
GOOGLE_MAPS_API_KEY=
CAREROUTE_RATE_PER_MIN=20
CAREROUTE_BURST=5
CAREROUTE_API_KEYS=
CAREROUTE_DAILY_CALL_CAP=0
CAREROUTE_ALLOWED_ORIGINS=*
CAREROUTE_TRUST_XFF=1
CAREROUTE_GEOCODE_COUNTRIES=in
CAREROUTE_REQUIRE_SHARED_STATE=0
CAREROUTE_SESSION_TTL=1800
CAREROUTE_PG_AUTO_MIGRATE=1
# --- Self-hosted map data (step 2). docker-compose.yml sets these for you;
# set them yourself only when running server.py outside Compose.
# overpass = public mirrors (demo only; never load-test against it)
# postgis  = local import from infra/geo/import.sh
OSM_SOURCE=overpass
# GEO_DATABASE_URL=            # defaults to DATABASE_URL
# OSRM_BASE_URL=http://localhost:5000
# NOMINATIM_URL=http://localhost:8080
# --- LLM call limits. The OpenAI SDK default timeout is 600 s; a hung model
# should fail fast (the API then answers 503 with the emergency number).
CAREROUTE_LLM_TIMEOUT_S=30
CAREROUTE_LLM_MAX_RETRIES=2
# CAREROUTE_OPENAI_MODEL=gpt-4o-mini
# --- Load tests come from ONE IP: raise the per-IP limit for them only.
# CAREROUTE_RATE_PER_MIN=100000
# CAREROUTE_BURST=100000
# --- Advanced (defaults shown). Every variable CareRoute reads is in
# careroute/config.py; nothing else reads the environment.
# REDIS_URL=
# DATABASE_URL=
# CAREROUTE_KEY_PREFIX=careroute
# CAREROUTE_REDIS_TIMEOUT_S=1.0
# CAREROUTE_PG_POOL_MAX=10
# GEO_POOL_MAX=10
# GEO_STATEMENT_TIMEOUT_MS=2000
# OSRM_TIMEOUT_S=3
# CAREROUTE_MAX_LLM_CALLS=8
# CAREROUTE_MAX_SESSIONS=5000
# CAREROUTE_TURN_LOCK_S=180
# CAREROUTE_LOG_PII=0
# CAREROUTE_LOG_COORD_DP=2
# CAREROUTE_LOG_FILE=
# BLOB_ACCOUNT_URL=
# BLOB_CONTAINER=patient-data
# DATA_DIR=./data
# GIT_SHA=local-dev
